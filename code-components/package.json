{
  "name": "harvey-code-components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n preview,import -c cyan,magenta \"npm run dev:preview\" \"npm run import:watch\"",
    "bundle": "webflow devlink bundle",
    "import": "webflow devlink import --no-input",
    "css": "tailwindcss -i src/globals.css -o preview/dist/globals.css",
    "import:watch": "node scripts/watch-import.mjs",
    "dev:preview": "npm run css -- --watch & esbuild preview/home.tsx preview/words.tsx --bundle --outdir=preview/dist --servedir=preview --serve=4000",
    "ship": "npm run bundle && npm run import",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bundle:local": "webflow devlink bundle --public-path http://localhost:4000/",
    "test:join": "esbuild src/lib/catalog-join.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/catalog-join.test.cjs --log-level=error && node /tmp/catalog-join.test.cjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.42.0",
    "postcss": "^8.5.28",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@webflow/data-types": "^2.3.0",
    "@webflow/react": "^2.3.0",
    "@webflow/webflow-cli": "^2.8.0-next.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.10",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
